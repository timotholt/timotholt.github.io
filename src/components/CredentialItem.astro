---
interface Props {
  tag?: 'li' | 'article';
  rowClass?: string;
  year: string;
  title: string;
  gpa?: string;
  what?: string;
  meta: string;
  italicWhat?: boolean;
  metaFirst?: boolean;
}
const { tag: Tag = 'li', rowClass = '', year, title, gpa, what, meta, italicWhat, metaFirst = false } = Astro.props;
---
<Tag class={rowClass ? `${rowClass} cred-item` : 'cred-item'}>
  <span class="cred-year h3">{year}</span>
  <div class="cred-body">
    <h3>{title}{gpa && <span class="cred-gpa-inline">{gpa}</span>}</h3>
    {metaFirst && <p class="cred-meta">{meta}</p>}
    {what && <p class="cred-what">{italicWhat ? <em>{what}</em> : what}</p>}
    {!metaFirst && <p class="cred-meta">{meta}</p>}
  </div>
</Tag>
