---
interface Props {
  tag?: 'li' | 'article';
  rowClass?: string;
  year: string;
  title: string;
  gpa?: string;
  what?: string;
  meta: string;
  italicWhat?: boolean;
  metaFirst?: boolean;
  link?: { href: string; label: string; arrowOnly?: boolean };
}
const { tag: Tag = 'li', rowClass = '', year, title, gpa, what, meta, italicWhat, metaFirst = false, link } = Astro.props;
// An arrow-only link ends the row's last line; a labelled link follows the description.
const arrowLast = Boolean(link?.arrowOnly && !metaFirst);
---
<Tag class={rowClass ? `${rowClass} cred-item` : 'cred-item'}>
  <span class="cred-year h3">{year}</span>
  <div class="cred-body">
    <h3>{title}{gpa && <span class="cred-gpa-inline">{gpa}</span>}</h3>
    {metaFirst && <p class="cred-meta">{meta}</p>}
    {what && <p class="cred-what">{italicWhat ? <em>{what}</em> : what}{link && !arrowLast && <>{' '}{link.arrowOnly
      ? <a class="cred-link cred-link-arrow" href={link.href} target="_blank" rel="noopener" aria-label={link.label}><span aria-hidden="true">↗</span></a>
      : <a class="cred-link" href={link.href} target="_blank" rel="noopener">{link.label} <span aria-hidden="true">↗</span></a>}</>}</p>}
    {!metaFirst && <p class="cred-meta">{meta}{link && arrowLast && <>{' '}<a class="cred-link cred-link-arrow" href={link.href} target="_blank" rel="noopener" aria-label={link.label}><span aria-hidden="true">↗</span></a></>}</p>}
  </div>
</Tag>
