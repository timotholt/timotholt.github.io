---
import { sectionByKey, sectionStyle } from '../../data/sections';
import { contact } from '../../data/contact';
import ContactList from '../ContactList.astro';
---
<section id="contact" class="section contact-section trace-section feature-slot color-section" data-section-key="contact" data-section-label={sectionByKey.contact.label} style={sectionStyle('contact')} data-milestone="Contact">
  <div class="wrap">
    <span class="trace-via" aria-hidden="true"></span>
    <h2>Put Tim to<br />
      <em>work</em>
    </h2>
    <p>Hiring an intern or junior engineer for AI, software or firmware work? Tim can start now.</p>
    <div class="contact-identity">
      <strong>{contact.name}</strong>
      <span>{contact.title}</span>
    </div>
    <ContactList />
    <div class="contact-actions">
      <a class="button button-outline" href={contact.resumeHref} target="_blank" rel="noopener">Download Tim's résumé (PDF) <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
