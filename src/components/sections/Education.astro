---
import { sectionByKey, sectionStyle } from '../../data/sections';
import CredentialItem from '../CredentialItem.astro';
import { education } from '../../data/education';
---
<section id="education" class="section band trace-section feature-slot color-section cred-section" data-section-key="education" data-section-label={sectionByKey.education.label} style={sectionStyle('education')} data-milestone="Education">
  <span class="trace-via" aria-hidden="true"></span>
  <div class="wrap">
    <div class="section-heading">
      <h2>Education</h2>
    </div>
    <ul class="cred-list">
      {education.map(item => <CredentialItem {...item} />)}
    </ul>
  </div>
</section>
