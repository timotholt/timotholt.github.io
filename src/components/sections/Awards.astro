---
import { sectionByKey, sectionStyle } from '../../data/sections';
import CredentialItem from '../CredentialItem.astro';
import { awards } from '../../data/awards';
---
<section id="awards" class="section band trace-section feature-slot color-section cred-section" data-section-key="awards" data-section-label={sectionByKey.awards.label} style={sectionStyle('awards')} data-milestone="Awards">
  <span class="trace-via" aria-hidden="true"></span>
  <div class="wrap">
    <div class="section-heading">
      <h2>Awards</h2>
    </div>
    <ul class="cred-list">
      {awards.map(item => <CredentialItem {...item} />)}
    </ul>
  </div>
</section>
