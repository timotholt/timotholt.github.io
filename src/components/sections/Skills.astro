---
import { sectionByKey, sectionStyle } from '../../data/sections';
import { skillPages } from '../../data/skills';
---
<section id="skills" class="section trace-section color-section skills-section" data-section-key="skills" data-section-label={sectionByKey.skills.label} style={sectionStyle('skills')}>
  <div class="wrap">{skillPages.map((groups, p) => <div class="feature-slot skill-slot" data-milestone={`Skills · ${groups.map(g => g.title).join(', ')}`}>
      <div class="section-heading">
        <h2>Skills <span class="page-mark">({p + 1}/{skillPages.length})</span>
        </h2>
      </div>
      <div class="skill-grid">{groups.map(group => <article class="skill-card">
          <h3>{group.title}</h3>
          <p class="skill-years">{group.years}</p>
          <p class="skill-summary">{group.summary}</p>
          <ul class="skill-tags">{group.tags.map(tag => <li>{tag}</li>)}</ul>
        </article>)}</div>
    </div>
      )}</div>
</section>
