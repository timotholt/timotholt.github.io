---
import { sectionByKey, sectionStyle } from '../../data/sections';
import ProjectMedia from '../ProjectMedia.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects')).filter(p => p.data.featured).sort((a,b) => a.data.order - b.data.order);
// A card opens the real thing: the live site, or the repository when there is none.
const target = (p: (typeof projects)[number]) => p.data.demo ?? p.data.repo;
---
<section id="projects" class="section trace-section color-section" data-section-key="projects" data-section-label={sectionByKey.projects.label} style={sectionStyle('projects')}>
  <div class="wrap">
    <span class="trace-via" aria-hidden="true"></span>
    <div class="project-grid">
      {projects.map((project, i) => (
        <div class="feature-slot project-slot" data-milestone={project.data.title}>
          {i === 0 && <div class="project-intro">
          <div class="section-heading">
            <h2>Built to work</h2>
            <p>{projects.length} projects across interfaces, firmware, e-commerce and AI tooling. Click one to open it.</p>
          </div>
        </div>}
          <article class="project-card">
          <h3 class="card-title">
            <a href={target(project)} target="_blank" rel="noopener noreferrer">{project.data.title}<span aria-hidden="true">↗</span>
            </a>
          </h3>
          <ProjectMedia slug={project.id} title={project.data.title} />
          <div class="card-content">
            <p class="project-function">{project.data.summary}</p>
            <p class="card-stack label">{[project.data.year, ...project.data.stack].join(' · ')}</p>
            <div class="card-links label">
              {project.data.demo && <a href={project.data.demo} target="_blank" rel="noopener noreferrer">Live site ↗</a>}
              <a href={project.data.repo} target="_blank" rel="noopener noreferrer">Repository ↗</a>
              <a href={`/projects/${project.id}/`} target="_blank" rel="noopener">Case study ↗</a></div>
          </div>
        </article>
      </div>
      ))}</div>
  </div>
</section>
