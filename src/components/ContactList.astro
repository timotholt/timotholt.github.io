---
import { contact } from '../data/contact';
const items = [
  { label: 'Phone', value: contact.phone, href: contact.phoneHref, path: 'M5 3h4l2 5-2 2c1 2 3 4 5 5l2-2 5 2v4c0 1-1 2-2 2C10 21 3 14 3 5c0-1 1-2 2-2Z' },
  { label: 'Email', value: contact.email, href: contact.emailHref, path: 'M3 5h18v14H3z M3 6l9 7 9-7' },
  { label: 'LinkedIn', value: contact.linkedin, href: contact.linkedinHref, path: 'M4 9v11 M4 5v.1 M9 20V9h4v2c1-2 6-3 7 2v7 M2 2h20v20H2z' },
  { label: 'GitHub', value: contact.github, href: contact.githubHref, path: 'M9 19c-5 1-5-3-7-3 M15 22v-3c4-1 6-3 6-7 0-2-1-3-2-4 0-2 0-3-1-4-2 0-3 1-4 2h-4C9 5 8 4 6 4 5 5 5 6 5 8c-1 1-2 2-2 4 0 4 2 6 6 7v3 M9 22v-3' },
  { label: 'Location', value: contact.location, path: 'M12 22s8-7 8-13a8 8 0 0 0-16 0c0 6 8 13 8 13Z M12 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z' },
];
---
<ul class="contact-list" aria-label="Contact information">
  {items.map(item => <li>{item.href ? <a href={item.href} aria-label={`${item.label}: ${item.value}`} {...(item.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={item.path}/></svg><span>{item.value}</span></a> : <span class="contact-item" aria-label={`${item.label}: ${item.value}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={item.path}/></svg><span>{item.value}</span></span>}</li>)}
</ul>
