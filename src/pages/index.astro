---
import Base from '../layouts/Base.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import ContactList from '../components/ContactList.astro';
import ChatPanel from '../components/ChatPanel.astro';
import { contact } from '../data/contact';
import { sectionByKey, sectionStyle } from '../data/sections';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects')).filter(p => p.data.featured).sort((a,b) => a.data.order - b.data.order);
// Skills, two groups per slot so each rail dot lands a full, settled screen.
const skillGroups = [
  { title: 'AI & software', years: '3 yrs AI-assisted · 2 yrs MERN', summary: 'Shipping real products with AI coding agents, from a live 30,000-book store to public projects.', tags: ['AI coding agents', 'TypeScript', 'JavaScript', 'Python', 'React / Node (MERN)', 'SolidJS', 'Astro', 'MCP', 'Rust / Axum'] },
  { title: 'Firmware & systems', years: '9 yrs firmware · 10 yrs Windows / macOS', summary: 'BIOS and device drivers that shipped in millions of PCs, plus DVD and pro-audio firmware.', tags: ['BIOS (C, x86 asm)', 'Windows device drivers', 'DVD / audio firmware', 'Windows & macOS support'] },
  { title: 'Field & telecom', years: '22 AT&T sites · 2023–2025', summary: 'Upgraded AT&T cell sites to 5G fiber transport, from the SOW to the last fiber jumper.', tags: ['5G fiber transport', 'SFPs & fiber runs', 'DC power cabling', 'SOWs'] },
  { title: 'Delivery & production', years: '23 yrs client work', summary: 'Two decades running film, live and AV productions on real budgets and deadlines.', tags: ['Client & project management', 'Leading 20–40 contractors', 'Film / live / AV', 'Ableton audio'] },
];
const skillPages = [skillGroups.slice(0, 2), skillGroups.slice(2, 4)];
const experience = [
  { role: 'Partner · Software Engineer & IT Support', company: 'Egghead Rodeo · Los Angeles, CA', date: '2022–now', detail: "Built Chantel's Corner, a live online bookstore with 30,000 books, end to end with AI coding agents (Rust, Axum, HTMX, PostgreSQL). On-call Windows and macOS support for private clients." },
  { role: 'Director of Photography & Owner', company: 'Light Hollywood LLC · Burbank, CA', date: '2003–2026', detail: 'Shot 11 feature films, 50+ short films, 200+ commercials, and 700+ interviews. Award for Best Cinematography for Days of Reckoning. Led 20–40 contractors on productions up to $500,000.' },
  { role: 'Contractor for AT&T', company: 'Ventura Telephone (VenTel) · Ventura, CA', date: '2023–2025', detail: 'Upgraded 22 AT&T cell tower sites across Southern California to Fujitsu flexiHaul HSN8300NA 5G fiber-optic transport. Wrote SOWs, installed SFPs, pulled SC/LC fiber runs and jumpers, and DC power plant cabling.' },
  { role: 'Firmware Engineer', company: 'VM Labs · Mountain View, CA', date: '2000–2001', detail: 'Shipped DVD firmware for six NUON DVD/game systems from Toshiba, Samsung, and Panasonic, with a global team on fault-tolerant firmware for high-volume products.' },
  { role: 'Senior Software Engineer', company: 'Spruce Technologies · San Jose, CA', date: '1998–2000', detail: 'Designed and delivered Plug-and-Play support for the Windows NT driver of the Spruce Dolby AC-3 audio card, and tuned driver performance for professional audio.' },
  { role: 'Programmer', company: 'Metalithic Systems · Sausalito, CA', date: '1996–1998', detail: 'Wrote Windows device drivers for Digital Wings, an FPGA-based digital audio workstation.' },
  { role: 'Design Engineer', company: 'Advanced Micro Devices · Santa Clara, CA', date: '1994–1996', detail: 'Wrote Windows device drivers and firmware for the InterWave audio card; integrated 13+ software components from a distributed team of 25+ engineers.' },
  { role: 'Design Engineer', company: 'Quantum · Milpitas, CA', date: '1992–1993', detail: 'Wrote the Windows device driver and hard-drive firmware for the Passport XL removable drive, built for 24/7 enterprise use and 50,000+ hours MTBF.' },
  { role: 'Software Engineer', company: 'Phoenix Technologies · San Jose, CA', date: '1988–1992', detail: 'Wrote motherboard BIOS in C and x86 assembly that shipped in millions of PCs from Toshiba, NEC, and Fujitsu. Invented and shipped FastBoot and Save-To-Disk.' }
];
// Job history is paged so every rail dot lands a full, settled screen.
const jobPages = [
  { label: 'Work · since 2002', era: 'Since 2002', jobs: [experience[0], experience[2], experience[1]] },
  { label: 'Work · engineering 1996–2001', era: 'Engineering 1996–2001', jobs: experience.slice(3, 6) },
  { label: 'Work · engineering 1988–1996', era: 'Engineering 1988–1996', jobs: experience.slice(6, 9) },
];
const proofs = [
  { value: 'Millions', label: 'of PCs shipped my BIOS', detail: 'Phoenix Technologies / Toshiba, NEC, Fujitsu / invented FastBoot' },
  { value: '22', count: '22', label: 'AT&T cell sites on 5G fiber', detail: 'Fujitsu flexiHaul transport / VenTel, 2023–2025' },
  { value: '30,000', count: '30000', label: 'books in a live store', detail: "Chantel's Corner / built end to end with AI coding agents" },
  { value: '4.0', count: '4.0', label: 'GPA in AI Software Engineering', detail: 'Maestro College / in progress' },
];
---
<Base title="Tim Otholt — AI Engineer & Software Builder" description="Tim Otholt builds AI-assisted tools, full-stack products, and interactive software, drawing on a background in firmware and production.">
  <aside class="progress-rail" aria-label="Page scroll progress"><div class="rail-track"><div class="rail-fill"></div></div><div class="rail-dots"></div><div class="rail-readout"><span id="scroll-percent">000%</span><span id="rail-section">00.0 HOME</span></div></aside>
  <section class="hero wrap trace-section feature-slot color-section" data-section-key="contact" data-section-label={sectionByKey.contact.label} style={sectionStyle('contact')} data-milestone="Home" aria-labelledby="hero-title">
    <div class="portrait-unit"><div class="portrait"><img src="/headshot.jpg" alt="Tim Otholt" width="900" height="900" /></div></div>
    <div class="hero-copy"><h1 id="hero-title"><span class="name-tim">Tim</span> <span class="name-otholt">Otholt</span></h1><p class="hero-title">{contact.title}</p><p class="hero-pitch">BIOS that shipped in millions of PCs → software built with AI coding agents.</p><ContactList /><div class="hero-actions"><button class="button button-ai" type="button" data-open-chat aria-haspopup="dialog" aria-controls="ask-ai"><svg class="ai-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"/><path d="M19 14l.8 2.2L22 17l-2.2.8L19 20l-.8-2.2L16 17l2.2-.8z"/></svg>Chat with my AI</button><a class="button button-outline" href="#projects">View my work <span aria-hidden="true">↗</span></a></div></div>
  </section>
  <section id="highlights" class="color-section hl-section" data-section-key="highlights" data-section-label={sectionByKey.highlights.label} style={sectionStyle('highlights')}><div id="about" class="wrap"><div class="feature-slot hl-slot hl-intro" data-milestone="Highlights"><h2>From firmware to<br /><em>what's next</em></h2><div class="hl-copy"><p>I started in low-level engineering, then spent two decades leading production and AV work. Today I bring that mix of technical depth and real-world delivery to AI-assisted software and full-stack products.</p><p>I'm studying AI Software Engineering at Maestro College and building public projects that turn ideas into working systems.</p></div></div><div class="feature-slot hl-slot hl-proofs" data-milestone="Proof points"><h2>Highlights</h2><ul class="proof-grid">{proofs.map(proof => <li class="proof-card"><span class="proof-value" data-count={proof.count}>{proof.value}</span><span class="proof-label">{proof.label}</span><small>{proof.detail}</small></li>)}</ul></div></div></section>
  <!-- TODO(tim): Review and approve the featured project copy. -->
  <section id="projects" class="section trace-section color-section" data-section-key="projects" data-section-label={sectionByKey.projects.label} style={sectionStyle('projects')}><div class="wrap"><span class="trace-via" aria-hidden="true"></span><div class="project-grid">{projects.map((project,i) => <div class="feature-slot project-slot" data-milestone={project.data.title}>{i === 0 && <div class="project-intro"><div class="section-heading"><h2>Built to work</h2><p>{projects.length} projects across interface, firmware, product, and portfolio engineering. Each has a closer look inside.</p></div></div>}<article class="project-card"><h3 class="card-title"><a href={`/projects/${project.id}/`} target="_blank" rel="noopener">{project.data.title}<span aria-hidden="true">↗</span></a></h3><ProjectMedia slug={project.id} title={project.data.title} /><div class="card-content"><p class="project-function">{project.data.summary}</p><p class="card-stack">{project.data.stack.join(' · ')}</p><div class="card-links"><a href={`/projects/${project.id}/`} target="_blank" rel="noopener">Case study ↗</a><a href={project.data.repo} target="_blank" rel="noopener noreferrer">Repository ↗</a>{project.data.demo && <a href={project.data.demo} target="_blank" rel="noopener noreferrer">Live demo ↗</a>}</div></div></article></div>)}</div><p class="project-note">Live demo links will appear after Tim confirms public URLs. Every project has a repository and a case study.</p></div></section>
  <section id="skills" class="section trace-section color-section skills-section" data-section-key="skills" data-section-label={sectionByKey.skills.label} style={sectionStyle('skills')}><div class="wrap">{skillPages.map((groups, p) => <div class="feature-slot skill-slot" data-milestone={`Skills · ${groups.map(g => g.title).join(', ')}`}><div class="section-heading"><h2>Skills <span class="page-mark">({p + 1}/{skillPages.length})</span></h2></div><div class="skill-grid">{groups.map(group => <article class="skill-card"><h3>{group.title}</h3><p class="skill-years">{group.years}</p><p class="skill-summary">{group.summary}</p><ul class="skill-tags">{group.tags.map(tag => <li>{tag}</li>)}</ul></article>)}</div></div>)}</div></section>
  <section id="experience" class="section trace-section color-section" data-section-key="jobs" data-section-label={sectionByKey.jobs.label} style={sectionStyle('jobs')}><div class="wrap"><span class="trace-via" aria-hidden="true"></span>{jobPages.map((page, p) => <div class="feature-slot job-page" data-milestone={page.label}><div class="section-heading"><h2>Work History <span class="page-mark">({p + 1}/{jobPages.length})</span></h2></div><div class="cred-list job-list">{page.jobs.map(job => <article class="job-row cred-item"><span class="cred-year">{job.date}</span><div class="cred-body"><h3>{job.role}</h3><p class="cred-meta">{job.company}</p><p class="cred-what">{job.detail}</p></div></article>)}</div></div>)}</div></section>
  <section id="education" class="section band trace-section feature-slot color-section cred-section" data-section-key="education" data-section-label={sectionByKey.education.label} style={sectionStyle('education')} data-milestone="Education"><span class="trace-via" aria-hidden="true"></span><div class="wrap"><div class="section-heading"><h2>Education</h2></div><ul class="cred-list"><li class="cred-item"><span class="cred-year">2027</span><div class="cred-body"><h3>AAS in AI Software Engineering<span class="cred-gpa-inline">, GPA 4.0</span></h3><p class="cred-what">In progress, expected December 2027</p><p class="cred-meta">Maestro College</p></div></li><li class="cred-item"><span class="cred-year">2024</span><div class="cred-body"><h3>MERN Full Stack Software Engineering<span class="cred-gpa-inline">, GPA 3.8</span></h3><p class="cred-what">2nd in class, Core Values Award, full scholarship</p><p class="cred-meta">Per Scholas</p></div></li><li class="cred-item"><span class="cred-year">2014–2016</span><div class="cred-body"><h3>Electronic Music Production Certificate</h3><p class="cred-what">Ableton Live</p><p class="cred-meta">Dubspot Hollywood</p></div></li><li class="cred-item"><span class="cred-year">1985–1987</span><div class="cred-body"><h3>Information &amp; Computer Science Coursework</h3><p class="cred-meta">University of Hawaii at Mānoa</p></div></li></ul></div></section>
  <section id="awards" class="section band trace-section feature-slot color-section cred-section" data-section-key="awards" data-section-label={sectionByKey.awards.label} style={sectionStyle('awards')} data-milestone="Awards"><span class="trace-via" aria-hidden="true"></span><div class="wrap"><div class="section-heading"><h2>Awards</h2></div><ul class="cred-list"><li class="cred-item"><span class="cred-year">2024</span><div class="cred-body"><h3>Core Values Award in Software Engineering</h3><p class="cred-what">Ambition, Integrity &amp; Perseverance</p><p class="cred-meta">Per Scholas</p></div></li><li class="cred-item"><span class="cred-year">2006</span><div class="cred-body"><h3>Best Cinematography</h3><p class="cred-what"><em>Days of Reckoning</em></p><p class="cred-meta">168 Hour Film Festival</p></div></li><li class="cred-item"><span class="cred-year">1997</span><div class="cred-body"><h3>Winner, PSXPower Contest</h3><p class="cred-what">For new game developers · Prize: Sony Net Yaroze PlayStation dev kit</p><p class="cred-meta">IGN</p></div></li></ul></div></section>
  <section id="contact" class="section contact-section trace-section feature-slot color-section" data-section-key="contact" data-section-label={sectionByKey.contact.label} style={sectionStyle('contact')} data-milestone="Contact"><div class="wrap"><span class="trace-via" aria-hidden="true"></span><h2>Let's make something<br /><em>work</em></h2><p>Hiring for AI engineering, forward deployed, or firmware work? I'd like to hear about it.</p><div class="contact-identity"><strong>{contact.name}</strong><span>{contact.title}</span></div><ContactList /></div></section>
  <ChatPanel />
  <script src="../scripts/home.ts"></script>
</Base>
