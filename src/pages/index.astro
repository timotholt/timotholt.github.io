---
import Base from '../layouts/Base.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import { hasHeadshot } from '../lib/projectMedia';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects')).filter(p => p.data.featured).sort((a,b) => a.data.order - b.data.order);
const skills = [
  { name: 'AI / LLM', items: ['AI-assisted software development', 'Spec-driven workflows', 'Agent instructions', 'Code review of agent output'] },
  { name: 'Languages', items: ['TypeScript', 'JavaScript', 'Python', 'SQL / PostgreSQL', 'C', 'x86 assembly', 'Rust'] },
  { name: 'Infrastructure', items: ['PostgreSQL', 'Node.js', 'Axum', 'GitHub Actions', 'Google Compute Engine (basic)'] },
  { name: 'Tools & interfaces', items: ['React', 'HTMX', 'Git', 'Claude Code', 'OpenAI Codex', 'ChatGPT', 'Gemini'] }
];
const experience = [
  { role: 'IT Support Specialist & Software Engineer', company: 'Egghead Rodeo', date: '2022 — present', detail: 'Part-time software engineering and IT support across practical business needs.' },
  { role: 'Cell Site Contractor', company: 'Ventel Telephone LLC', date: '2023 — 2025', detail: 'Upgraded fiber-optic network routers at 22 Southern California cell sites without interrupting service.' },
  { role: 'Owner, Production & AV', company: 'Light Hollywood LLC', date: '2003 — 2026', detail: 'Led film, production, and live-event AV projects, coordinating crews and technical delivery.' },
  { role: 'Firmware & Software Engineer', company: 'Phoenix Technologies · Quantum · AMD · Metalithic · Spruce · VM Labs', date: '1988 — 2001', detail: 'Worked on BIOS, firmware, drivers, and software. At Phoenix, wrote BIOS code from CPU reset through the Windows boot loader.' }
];
const specs = [
  { value: '22', suffix: '', label: 'Cell sites upgraded', detail: 'Southern California / no service interruption' },
  { value: '06', suffix: '', label: 'Selected projects', detail: 'Engineering / product / games' },
  { value: '4.0', suffix: '', label: 'Current GPA', detail: 'AI Software Engineering / Maestro College' }
];
---
<Base title="Tim Otholt — AI Engineer & Software Builder" description="Tim Otholt builds AI-assisted tools, full-stack products, and interactive software, drawing on a background in firmware and production.">
  <div class="signal-system" aria-hidden="true"><svg id="signal-trace" preserveAspectRatio="none"><path id="trace-base"/><path id="trace-active"/></svg></div>
  <section class="hero wrap trace-section" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> AVAILABLE FOR ENGINEERING OPPORTUNITIES <span class="hero-ref">DOC / TO—001</span></p>
      <h1 id="hero-title">Tim<br />Otholt<span class="accent">.</span></h1>
      <!-- TODO(tim): Confirm exact title line. -->
      <p class="hero-title">AI Engineer <span>/</span> Forward Deployed Engineer</p>
      <p class="hero-pitch">I build useful software where people, systems, and new technology meet. My work spans AI-assisted tools, full-stack products, and firmware—and I care about making each one clear, testable, and practical.</p>
      <!-- TODO(tim): Confirm Los Angeles, CA as the public location and America/Los_Angeles as the clock timezone. -->
      <div class="hero-meta"><span>LOC / Los Angeles, CA</span><span>LOCAL / <time id="local-clock" aria-label="Local time in Los Angeles">--:--</time> PT</span></div>
      <div class="hero-actions"><a class="button button-primary" href="#projects">View my work <span aria-hidden="true">↗</span></a><button class="button button-muted" type="button" disabled title="Ask My AI is coming soon">Ask My AI <span class="soon">Coming soon</span></button><a class="button button-text" href="#contact">Get in touch ↗</a></div>
      <div class="socials" aria-label="Social links"><a href="https://github.com/timotholt" target="_blank" rel="noopener noreferrer">GitHub ↗</a><span>LinkedIn · TODO(tim)</span><a href="mailto:tim@timotholt.com">Email ↗</a></div>
    </div>
    <div class="hero-art"><div class="wave-panel"><div class="wave-top"><span>FIG 01 / LIVE SIGNAL</span><span>OSC / 01</span></div><svg id="waveform" viewBox="0 0 600 350" role="img" aria-label="Animated oscilloscope waveform"><path class="wave-axis" d="M0 175H600"/><path id="wave-line" d="M0 175H600"/></svg><div class="wave-bottom"><span>INPUT / POINTER + SCROLL</span><span>SIGNAL / VISUAL STUDY</span></div></div>{hasHeadshot && <img class="headshot" src="/headshot.jpg" alt="Tim Otholt" width="220" height="220" />}</div>
  </section>
  <section id="about" class="section about-section wrap trace-section"><span class="trace-via" aria-hidden="true"></span><div class="section-label">01.0 / PROFILE</div><div class="about-grid"><h2>From firmware to<br /><em>what's next.</em></h2><div><p>I started in low-level engineering, then spent two decades leading production and AV work. Today I bring that mix of technical depth and real-world delivery to AI-assisted software and full-stack products.</p><p>I'm studying AI Software Engineering at Maestro College and building public projects that turn ideas into working systems.</p></div></div><div class="metric-grid">{specs.map(spec => <div class="metric"><span class="metric-value" data-count={spec.value}>{spec.value}</span><span class="metric-label">{spec.label}</span><small>{spec.detail}</small></div>)}</div></section>
  <!-- TODO(tim): Review and approve the six featured projects and all draft copy. -->
  <section id="projects" class="section wrap trace-section"><span class="trace-via" aria-hidden="true"></span><div class="section-label">02.0 / SELECTED WORK</div><div class="section-heading"><h2>Built to work<span class="accent">.</span></h2><p>Six projects across AI tooling, product engineering, and games. Each has a closer look inside.</p></div><div class="project-grid">{projects.map((project, i) => <article class="project-card"><div class="card-top"><span>PART NO. / TO-{String(i + 1).padStart(3, '0')}</span><span>{project.data.category}</span></div><ProjectMedia slug={project.id} title={project.data.title} /><div class="card-content"><h3><a href={`/projects/${project.id}/`}>{project.data.title}<span aria-hidden="true">↗</span></a></h3><p class="project-function">{project.data.summary}</p><dl class="spec-table"><div><dt>STACK</dt><dd>{project.data.stack.join(' / ')}</dd></div><div><dt>YEAR</dt><dd>See repository</dd></div><div><dt>ROLE</dt><dd>Builder</dd></div><div><dt>STATUS</dt><dd>{project.data.demo ? 'Public demo' : 'Public repository'}</dd></div></dl><div class="card-links"><a href={`/projects/${project.id}/`}>Case study ↗</a><a href={project.data.repo} target="_blank" rel="noopener noreferrer">Repository ↗</a>{project.data.demo && <a href={project.data.demo} target="_blank" rel="noopener noreferrer">Live demo ↗</a>}</div></div></article>)}</div><p class="project-note">Live demo links will appear after Tim confirms public URLs. Every project has a repository and a case study.</p></section>
  <section id="skills" class="section band trace-section"><span class="trace-via" aria-hidden="true"></span><div class="wrap"><div class="section-label">03.0 / CAPABILITIES</div><div class="section-heading"><h2>Pinout<span class="accent">.</span></h2><p>Focused on making technology useful, from low-level systems to modern interfaces.</p></div><div class="pinout"><div class="pinout-head"><span>PIN</span><span>FUNCTION</span><span>INTERFACE / TOOLS</span></div>{skills.map((group, i) => <div class="pinout-row"><span class="pin-number">{String(i + 1).padStart(2, '0')}</span><h3>{group.name}</h3><p>{group.items.join(' · ')}</p></div>)}</div></div></section>
  <section id="experience" class="section wrap trace-section"><span class="trace-via" aria-hidden="true"></span><div class="section-label">04.0 / REVISION HISTORY</div><div class="section-heading"><h2>Field notes<span class="accent">.</span></h2><p>A path through engineering, production, and hands-on technical delivery.</p></div><div class="revision-table"><div class="revision-head"><span>PERIOD</span><span>ASSIGNMENT</span><span>WORK PERFORMED</span></div>{experience.map(job => <article class="revision-row"><span class="revision-date">{job.date}</span><div><h3>{job.role}</h3><p class="company">{job.company}</p></div><p>{job.detail}</p></article>)}</div></section>
  <section id="education" class="section band trace-section"><span class="trace-via" aria-hidden="true"></span><div class="wrap"><div class="section-label">05.0 / QUALIFICATIONS</div><div class="section-heading"><h2>Continued study<span class="accent">.</span></h2></div><div class="credential-grid"><div class="credential"><span>IN PROGRESS · EXPECTED 2027</span><h3>A.A.S. AI Software Engineering</h3><p>Maestro College · 4.0 GPA</p></div><div class="credential"><span>2024</span><h3>Software Engineering Certificate</h3><p>Per Scholas · 3.8 GPA</p></div><div class="credential"><span>2014–2016</span><h3>Electronic Music Production</h3><p>Dubspot · Ableton Live</p></div><div class="credential"><span>COURSEWORK</span><h3>Information & Computer Science</h3><p>University of Hawaiʻi at Mānoa · no degree</p></div></div><div class="award-line"><span>SELECTED RECOGNITION</span><p>IGN PSXPower Contest winner (1997) · Best Cinematography, 168 Hour Film Festival (2006) · Per Scholas Core Values Award (2024)</p></div></div></section>
  <section id="contact" class="section contact-section wrap trace-section"><span class="trace-via" aria-hidden="true"></span><div class="section-label">06.0 / CONTACT</div><h2>Let's make something<br /><em>work.</em></h2><p>Interested in an engineering role, a product problem, or a project? Send me a note.</p><a class="contact-mail" href="mailto:tim@timotholt.com">tim@timotholt.com <span aria-hidden="true">↗</span></a><div class="contact-links"><a href="https://github.com/timotholt" target="_blank" rel="noopener noreferrer">GitHub ↗</a><span>LinkedIn · TODO(tim): add URL</span><span>Resume PDF · TODO(tim): provide approved file</span></div></section>
  <script src="../scripts/home.ts"></script>
</Base>
