---
import Base from '../layouts/Base.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import ContactList from '../components/ContactList.astro';
import { contact } from '../data/contact';
import { sectionByKey, sectionStyle } from '../data/sections';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects')).filter(p => p.data.featured).sort((a,b) => a.data.order - b.data.order);
const pins = [
  { signal:'FW_BIOS', dir:'I/O', description:'Firmware, BIOS & Windows device drivers · Phoenix BIOS / FastBoot, 1988–2001 era', years:'9', level:'Expert' },
  { signal:'AI_DEV', dir:'I/O', description:'AI-assisted software development', years:'3', level:'Expert' },
  { signal:'CLIENT_MGMT', dir:'I/O', description:'Client management & project coordination', years:'23', level:'Expert' },
  { signal:'WIN_MAC', dir:'I/O', description:'Windows and macOS', years:'10', level:'Expert' },
  { signal:'MERN', dir:'I/O', description:'MongoDB, Express, React, Node', years:'2', level:'Intermediate' },
  { signal:'RF_FIBER', dir:'I/O', description:'Fiber-optic network router upgrades at cell sites · Ventel, 2023–2025', years:'', level:'' },
  { signal:'AV_FILM', dir:'I/O', description:'Film / live production / AV · Best Cinematography 2006', years:'', level:'' },
  { signal:'AUDIO_DAW', dir:'I/O', description:'Electronic music production · Ableton Live, Dubspot 2014–2016', years:'', level:'' },
  { signal:'BUS[0..5]', dir:'I/O', description:'TypeScript · JavaScript · Python · SolidJS · Astro · MCP', years:'', level:'' },
];
const experience = [
  { role: 'IT Support Specialist & Software Engineer', company: 'Egghead Rodeo', date: '2022 — present', detail: 'Part-time software engineering and IT support across practical business needs.' },
  { role: 'Cell Site Contractor', company: 'Ventel Telephone LLC', date: '2023 — 2025', detail: 'Upgraded fiber-optic network routers at 22 Southern California cell sites without interrupting service.' },
  { role: 'Owner, Production & AV', company: 'Light Hollywood LLC', date: '2003 — 2026', detail: 'Led film, production, and live-event AV projects, coordinating crews and technical delivery.' },
  { role: 'Firmware & Software Engineer', company: 'Phoenix Technologies · Quantum · AMD · Metalithic · Spruce · VM Labs', date: '1988 — 2001', detail: 'Worked on BIOS, firmware, drivers, and software. At Phoenix, wrote BIOS code from CPU reset through the Windows boot loader.' }
];
const jobsSince = experience.filter(job => Number(job.date.slice(0, 4)) >= 2002);
const jobsEng = experience.filter(job => Number(job.date.slice(0, 4)) < 2002);
const specs = [
  { value: '22', suffix: '', label: 'Cell sites upgraded', detail: 'Southern California / no service interruption' },
  { value: String(projects.length).padStart(2, '0'), suffix: '', label: 'Selected projects', detail: 'Engineering / product / portfolio' },
  { value: '4.0', suffix: '', label: 'Current GPA', detail: 'AI Software Engineering / Maestro College' }
];
---
<Base title="Tim Otholt — AI Engineer & Software Builder" description="Tim Otholt builds AI-assisted tools, full-stack products, and interactive software, drawing on a background in firmware and production.">
  <aside class="progress-rail" aria-label="Page scroll progress"><div class="rail-track"><div class="rail-fill"></div></div><div class="rail-dots"></div><div class="rail-readout"><span id="scroll-percent">000%</span><span id="rail-section">00.0 HOME</span></div></aside>
  <section class="hero wrap trace-section feature-slot color-section" data-section-key="contact" data-section-label={sectionByKey.contact.label} style={sectionStyle('contact')} data-milestone="Home" aria-labelledby="hero-title">
    <div class="portrait-unit"><div class="portrait"><img src="/headshot.jpg" alt="Tim Otholt" width="900" height="900" /><canvas id="face-mesh" aria-hidden="true"></canvas><div class="scan-line" aria-hidden="true"></div></div></div>
    <div class="hero-copy"><h1 id="hero-title"><span class="name-tim">Tim</span> <span class="name-otholt">Otholt<span class="accent">.</span></span></h1><p class="hero-title">{contact.title}</p><p class="hero-pitch">BIOS that shipped in millions of PCs → software built with AI coding agents.</p><ContactList /><div class="hero-actions"><a class="button button-primary" href="#projects">View my work <span aria-hidden="true">↗</span></a><button class="button button-muted" type="button" disabled>Ask my AI · soon</button></div></div>
  </section>
  <section id="highlights" class="color-section" data-section-key="highlights" data-section-label={sectionByKey.highlights.label} style={sectionStyle('highlights')}><div class="chip-section wrap feature-slot" data-milestone="BIOS chip" aria-label="BIOS silicon package"><div class="chip-stage"><div class="chip-intro"><div class="section-label">01.0 / HIGHLIGHTS</div><h2>Highlights<span class="accent">.</span></h2></div><span class="chip-stage-label">FIG 01 / SYSTEM ON CHIP</span><svg class="bios-chip" viewBox="0 0 400 300" role="img" aria-label="OTHOLT-BIOS integrated circuit with silicon die and pins"><defs><pattern id="die-grid" width="12" height="12" patternUnits="userSpaceOnUse"><path d="M12 0H0V12" fill="none" stroke="currentColor" stroke-opacity=".25" stroke-width=".6"/></pattern></defs><g class="chip-leads">{Array.from({length:12},(_,i)=><g><path d={`M12 ${35+i*21}H65M335 ${35+i*21}H388`}/><text x="17" y={32+i*21}>{String(i+1).padStart(2,'0')}</text><text x="354" y={32+i*21}>{String(24-i).padStart(2,'0')}</text></g>)}</g><rect class="chip-body" x="64" y="15" width="272" height="270" rx="8"/><rect class="die-window" x="93" y="44" width="214" height="212"/><rect x="93" y="44" width="214" height="212" fill="url(#die-grid)"/><g class="die-art">{Array.from({length:6},(_,i)=><g><rect x={108+(i%3)*64} y={63+Math.floor(i/3)*86} width="44" height="54"/><path d={`M${108+(i%3)*64} ${75+Math.floor(i/3)*86}h44M${108+(i%3)*64} ${91+Math.floor(i/3)*86}h44`}/></g>)}<path d="M112 132H288M112 145H288M112 158H288M175 62V235M239 62V235"/></g><text class="die-title" x="200" y="151" text-anchor="middle">OTHOLT / BIOS</text></svg><span class="chip-stage-label">SILICON / SIGNAL PATH</span></div></div>
  <div id="about" class="section about-section wrap trace-section"><span class="trace-via" aria-hidden="true"></span><div class="metric-grid">{specs.map((spec,i) => <div class="feature-slot metric-slot" data-milestone={spec.label}>{i === 0 && <><div class="about-grid"><h2>From firmware to<br /><em>what's next.</em></h2><div><p>I started in low-level engineering, then spent two decades leading production and AV work. Today I bring that mix of technical depth and real-world delivery to AI-assisted software and full-stack products.</p><p>I'm studying AI Software Engineering at Maestro College and building public projects that turn ideas into working systems.</p></div></div></>}<div class="metric"><span class="metric-value" data-count={spec.value}>{spec.value}</span><span class="metric-label">{spec.label}</span><small>{spec.detail}</small></div></div>)}</div></div></section>
  <!-- TODO(tim): Review and approve the featured project copy. -->
  <section id="projects" class="section trace-section color-section" data-section-key="projects" data-section-label={sectionByKey.projects.label} style={sectionStyle('projects')}><div class="wrap"><span class="trace-via" aria-hidden="true"></span><div class="project-progress" aria-hidden="true">TO-001 / {String(projects.length).padStart(3, '0')}</div><div class="project-grid">{projects.map((project,i) => <div class="feature-slot project-slot" data-milestone={project.data.title}>{i === 0 && <div class="project-intro"><div class="section-label">02.0 / SELECTED WORK</div><div class="section-heading"><h2>Built to work<span class="accent">.</span></h2><p>{projects.length} projects across interface, firmware, product, and portfolio engineering. Each has a closer look inside.</p></div></div>}<article class="project-card"><div class="card-top"><span>PART NO. / TO-{String(project.data.order).padStart(3, '0')}</span><span>{project.data.category}</span></div><ProjectMedia slug={project.id} title={project.data.title} /><div class="card-content"><h3><a href={`/projects/${project.id}/`}>{project.data.title}<span aria-hidden="true">↗</span></a></h3><p class="project-function">{project.data.summary}</p><dl class="spec-table"><div><dt>STACK</dt><dd>{project.data.stack.join(' / ')}</dd></div><div><dt>YEAR</dt><dd>See repository</dd></div><div><dt>ROLE</dt><dd>Builder</dd></div><div><dt>STATUS</dt><dd>{project.data.status ?? (project.data.demo ? 'Public demo' : 'Public repository')}</dd></div></dl><div class="card-links"><a href={`/projects/${project.id}/`}>Case study ↗</a><a href={project.data.repo} target="_blank" rel="noopener noreferrer">Repository ↗</a>{project.data.demo && <a href={project.data.demo} target="_blank" rel="noopener noreferrer">Live demo ↗</a>}</div></div></article></div>)}</div><p class="project-note">Live demo links will appear after Tim confirms public URLs. Every project has a repository and a case study.</p></div></section>
  <section id="skills" class="section band trace-section color-section" data-section-key="skills" data-section-label={sectionByKey.skills.label} style={sectionStyle('skills')}><span class="trace-via" aria-hidden="true"></span><div class="wrap"><div class="skills-visual"><div class="logic-sweep" aria-hidden="true"></div><div class="package-drawing"><svg viewBox="0 0 900 180" role="img" aria-label="TIM-OTHOLT career package with numbered pins"><rect x="95" y="15" width="710" height="150" rx="12"/><circle cx="125" cy="42" r="7"/><text x="450" y="88" text-anchor="middle">TIM-OTHOLT</text><text x="450" y="117" text-anchor="middle">PKG: CAREER-48</text>{pins.map((_,i)=><g><path d={`M${128+i*76} 15V0M${128+i*76} 165v15`}/><text x={128+i*76} y="35" text-anchor="middle">{String(i+1).padStart(2,'0')}</text></g>)}</svg></div></div><div class="pinout"><div class="pinout-head"><span>PIN</span><span>SIGNAL</span><span>DIR</span><span>DESCRIPTION</span><span>YEARS</span><span>LEVEL</span><span>WAVE</span></div>{pins.map((pin,i)=><div class="feature-slot pin-slot" data-milestone={pin.signal}>{i === 0 && <div class="skills-intro"><div class="section-label">03.0 / CAPABILITIES</div><div class="section-heading"><h2>Pinout<span class="accent">.</span></h2><p>Focused on making technology useful, from low-level systems to modern interfaces.</p></div></div>}<div class="pinout-row"><span class="pin-number" data-label="PIN">{String(i+1).padStart(2,'0')}</span><h3 data-label="SIGNAL">{pin.signal}</h3><span data-label="DIR">{pin.dir}</span><p data-label="DESCRIPTION">{pin.description}</p><span data-label="YEARS">{pin.years ? `${pin.years} yrs` : '—'}</span><span data-label="LEVEL">{pin.level || '—'}</span><svg class="logic-wave" viewBox="0 0 80 20" aria-label={pin.years ? `${pin.years} year signal` : 'No years specified'}><path d={pin.years ? `M0 16H6V4H${6+Math.round(Number(pin.years)/23*65)}V16H80` : 'M0 16H80'}/></svg></div></div>)}</div></div></section>
  <section id="experience" class="section trace-section color-section" data-section-key="jobs-since" data-section-label={sectionByKey['jobs-since'].label} style={sectionStyle('jobs-since')}><div class="wrap"><span class="trace-via" aria-hidden="true"></span><div class="revision-table"><div class="revision-head"><span>PERIOD</span><span>ASSIGNMENT</span><span>WORK PERFORMED</span></div>{jobsSince.map((job,i) => <div class="feature-slot revision-slot" data-milestone={job.role}>{i === 0 && <div class="experience-intro"><div class="section-label">04.0 / REVISION HISTORY</div><div class="section-heading"><h2>Field notes — since 2002<span class="accent">.</span></h2><p>A path through production and hands-on technical delivery.</p></div></div>}<article class="revision-row"><span class="revision-date">{job.date}</span><div><h3>{job.role}</h3><p class="company">{job.company}</p></div><p>{job.detail}</p></article></div>)}</div></div></section>
  <section id="jobs-eng" class="section trace-section color-section" data-section-key="jobs-eng" data-section-label={sectionByKey['jobs-eng'].label} style={sectionStyle('jobs-eng')}><div class="wrap"><span class="trace-via" aria-hidden="true"></span><div class="revision-table"><div class="revision-head"><span>PERIOD</span><span>ASSIGNMENT</span><span>WORK PERFORMED</span></div>{jobsEng.map((job,i) => <div class="feature-slot revision-slot" data-milestone={job.role}>{i === 0 && <div class="experience-intro"><div class="section-label">05.0 / REVISION HISTORY</div><div class="section-heading"><h2>Field notes — engineering, 1988–2001<span class="accent">.</span></h2><p>Firmware, BIOS, drivers, and software.</p></div></div>}<article class="revision-row"><span class="revision-date">{job.date}</span><div><h3>{job.role}</h3><p class="company">{job.company}</p></div><p>{job.detail}</p></article></div>)}</div></div></section>
  <section id="awards" class="section band trace-section feature-slot color-section cred-section" data-section-key="awards" data-section-label={sectionByKey.awards.label} style={sectionStyle('awards')} data-milestone="Awards"><span class="trace-via" aria-hidden="true"></span><div class="wrap"><div class="section-label">06.0 / AWARDS</div><div class="section-heading"><h2>Awards<span class="accent">.</span></h2></div><ul class="cred-list"><li class="cred-item"><span class="cred-year">2024</span><div class="cred-body"><h3>Core Values Award</h3><p class="cred-what">Per Scholas</p><p class="cred-meta">Ambition, Integrity &amp; Perseverance</p></div></li><li class="cred-item"><span class="cred-year">2006</span><div class="cred-body"><h3>Best Cinematography</h3><p class="cred-what">168 Hour Film Festival</p><p class="cred-meta">Nominated again in 2008</p></div></li><li class="cred-item"><span class="cred-year">1997</span><div class="cred-body"><h3>Winner, IGN PSXPower Contest</h3><p class="cred-what">For new game developers</p><p class="cred-meta">Prize: Sony Net Yaroze PlayStation dev kit</p></div></li></ul></div></section>
  <section id="education" class="section band trace-section feature-slot color-section cred-section" data-section-key="education" data-section-label={sectionByKey.education.label} style={sectionStyle('education')} data-milestone="Education"><span class="trace-via" aria-hidden="true"></span><div class="wrap"><div class="section-label">07.0 / EDUCATION</div><div class="section-heading"><h2>Education<span class="accent">.</span></h2></div><ul class="cred-list"><li class="cred-item"><span class="cred-year">2027</span><div class="cred-body"><h3>Maestro College</h3><p class="cred-what">A.A.S. AI Software Engineering · in progress, expected December 2027</p><p class="cred-meta">40 credits · GPA 4.00</p></div></li><li class="cred-item"><span class="cred-year">2024</span><div class="cred-body"><h3>Per Scholas</h3><p class="cred-what">Software Engineer course · MERN full stack</p><p class="cred-meta">GPA 3.8 · 2nd in class · Core Values Award · 400+ hours, full scholarship</p></div></li><li class="cred-item"><span class="cred-year">2016</span><div class="cred-body"><h3>Dubspot</h3><p class="cred-what">Electronic Music Production certificate · Ableton Live, 2014–2016</p></div></li><li class="cred-item"><span class="cred-year">1987</span><div class="cred-body"><h3>University of Hawaii at Mānoa</h3><p class="cred-what">Information &amp; Computer Science coursework, 1985–1987</p></div></li></ul></div></section>
  <section id="contact" class="section contact-section trace-section feature-slot color-section" data-section-key="contact" data-section-label={sectionByKey.contact.label} style={sectionStyle('contact')} data-milestone="Contact"><div class="wrap"><span class="trace-via" aria-hidden="true"></span><div class="section-label">08.0 / CONTACT</div><h2>Let's make something<br /><em>work.</em></h2><p>Hiring for AI engineering, forward deployed, or firmware work? I'd like to hear about it.</p><div class="contact-identity"><strong>{contact.name}</strong><span>{contact.title}</span></div><ContactList /></div></section>
  <script src="../scripts/home.ts"></script>
</Base>
